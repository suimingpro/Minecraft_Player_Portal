# ============================================================
# Minecraft Player Portal - Docker Compose 生产环境配置
# ============================================================

# ------------------------------------------------------------
# 1. 统一反向代理网关 (Nginx Reverse Proxy Ports)
# ------------------------------------------------------------
# 外部访问的 HTTP 与 HTTPS 端口 (前端与后端统一入口，同域名访问)
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------
# 2. 内部微服务端口映射 (Direct Host Ports - 可选/开发调试使用)
# ------------------------------------------------------------
# 默认为 127.0.0.1 仅本机可见，防止未经 Nginx 反代直接被公网访问
CLIENT_HOST_IP=127.0.0.1
CLIENT_PORT=3000
SERVER_HOST_IP=127.0.0.1
SERVER_PORT=8000

# 数据库与 Redis 绑定 IP (默认 127.0.0.1 避免公网暴露)
MARIADB_HOST_IP=127.0.0.1
MARIADB_PORT=3306
REDIS_HOST_IP=127.0.0.1
REDIS_PORT=6379

# 数据库存储目录（切换为全新数据库可修改为 ./db/data_new 或执行 sudo rm -rf ./db/data/*）
DB_DATA_DIR=./db/data

# 容器内部监听端口 (默认 8000 和 3000)
SERVER_INTERNAL_PORT=8000
CLIENT_INTERNAL_PORT=3000

# ------------------------------------------------------------
# 3. 生产环境性能与并发设置 (Production Performance)
# ------------------------------------------------------------
# Uvicorn 多进程 Worker 数量（建议设置为 CPU 核心数 或 2~4）
WORKERS=2
# 日志级别 (info / warning / error)
LOG_LEVEL=info

# ------------------------------------------------------------
# 4. SSL / HTTPS 配置
# ------------------------------------------------------------
# 是否在网关 (Nginx) 启用 SSL (true / false)
# - 若为 true: 监听 443 (HTTPS) 并将 80 重定向到 443
# - 若为 false: 监听 80 提供标准 HTTP 访问
SSL_ENABLED=true

# 后端 Server 内部是否开启 SSL (在 Nginx 网关模式下通常保持 false，由 Nginx 统一定理 SSL 卸载)
SERVER_SSL_ENABLED=false

# 证书目录（宿主机路径，挂载至 Nginx /etc/nginx/certs 以及容器内部）
CERT_DIR=./cert

# 自定义证书文件路径 (可选，留空则自动检测 cert/ 中的证书)
# SSL_CERTFILE=/etc/nginx/certs/fullchain.pem
# SSL_KEYFILE=/etc/nginx/certs/privkey.pem

# Cookie Secure 标记：
# - 启用 SSL (HTTPS) 时必须为 true
# - 纯 HTTP 模式时必须设为 false，否则浏览器将拒绝存储登录会话 Cookie
COOKIE_SECURE=true

# ------------------------------------------------------------
# 5. 外部访问 URL 地址 (必须与浏览器实际访问协议和域名端口一致)
# ------------------------------------------------------------
# 在 Nginx 统一下，前端与后端共享相同域名和端口 (如 https://localhost 或 https://mc.example.com)
API_BASE_URL=https://localhost
FRONTEND_URL=https://localhost
NEXT_PUBLIC_API_BASE_URL=

# ------------------------------------------------------------
# 6. 数据库密码凭据
# ------------------------------------------------------------
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=
