# Copy this file to server/.env and fill in your deployment settings.
# Credential, connection and organization-specific settings are intentionally blank.
# DATABASE_URL format: mysql+asyncmy://<user>:<password>@<host>:<port>/<database>
# REDIS_URL format: redis://<host>:<port>/0
# YGGDRASIL_PRIVATE_KEY: path to your private key file.

DATABASE_URL=

REDIS_URL=

YGGDRASIL_PRIVATE_KEY=
YGGDRASIL_PUBLIC_KEY=./certs/yggdrasil/public.pem

YGGDRASIL_DOMAIN=example.com
# =========================
# Microsoft Entra SAML
# =========================

SAML_SP_ENTITY_ID=https://localhost/saml

SAML_SP_ACS_URL=https://localhost/auth/saml/acs

SAML_IDP_ENTITY_ID=

SAML_IDP_SSO_URL=

SAML_IDP_CERT_PATH=./certs/entra-saml.crt
# SST Portal 接收 Microsoft LogoutResponse / LogoutRequest
SAML_SP_SLS_URL=https://localhost/auth/saml/sls

# Microsoft Entra 的 SAML Logout URL
SAML_IDP_SLO_URL=

# =========================
# Application
# =========================

FRONTEND_URL=https://localhost


SESSION_COOKIE_NAME=minecraft_portal_session

COOKIE_SECURE=true

COOKIE_SAMESITE=lax

ADMIN_GROUPS=
